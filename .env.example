# ===========================================
# DATABASE
# ===========================================
# MySQL connection string for Prisma
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://username:password@localhost:3306/database_name"

# ===========================================
# NEXTAUTH
# ===========================================
# Secret used for JWT encryption (generate with: openssl rand -base64 32)
NEXTAUTH_SECRET="your-nextauth-secret-key-here"

# Base URL of your application
NEXTAUTH_URL="http://localhost:3000"

# ===========================================
# NOWPAYMENTS (configured in DB payments table)
# ===========================================
# The NOWPayments API key is stored in the `payments` table
# params JSON field -> option -> api_key
# No env variable needed — it reads from the database.

# ===========================================
# APPLICATION
# ===========================================
# Timezone (matches PHP TIMEZONE constant)
TZ="Pacific/Midway"
